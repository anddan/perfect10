rules_version = '2';

// The top lists of the endless game and of the match modes Save the cup, Even numbers, Defend the cups, Ice world, Fast fingers and Find the Perfect 10 (see src/ui/scores.ts); the three have the same rules. No accounts: a device is known by a random id, and its document in
// "highscores" has that id. Anyone can read the list; a device can only add its own document and can only raise its score (the
// name can change), size-bounded. Nobody can delete one from the game.
service cloud.firestore {
  match /databases/{database}/documents {
    function validName(name) {
      return name is string && name.size() >= 1 && name.size() <= 16;
    }

    match /highscores/{device} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['device', 'name', 'score', 'at'])
        && request.resource.data.device == device
        && validName(request.resource.data.name)
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 10000000
        && request.resource.data.at is number;
      allow update: if request.resource.data.keys().hasOnly(['device', 'name', 'score', 'at'])
        && request.resource.data.device == resource.data.device
        && validName(request.resource.data.name)
        && request.resource.data.score is int
        && request.resource.data.score >= resource.data.score
        && request.resource.data.score <= 10000000
        && request.resource.data.at is number;
      allow delete: if false;
    }

    match /highscores_save/{device} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['device', 'name', 'score', 'at'])
        && request.resource.data.device == device
        && validName(request.resource.data.name)
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 10000000
        && request.resource.data.at is number;
      allow update: if request.resource.data.keys().hasOnly(['device', 'name', 'score', 'at'])
        && request.resource.data.device == resource.data.device
        && validName(request.resource.data.name)
        && request.resource.data.score is int
        && request.resource.data.score >= resource.data.score
        && request.resource.data.score <= 10000000
        && request.resource.data.at is number;
      allow delete: if false;
    }

    match /highscores_sixeight/{device} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['device', 'name', 'score', 'at'])
        && request.resource.data.device == device
        && validName(request.resource.data.name)
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 10000000
        && request.resource.data.at is number;
      allow update: if request.resource.data.keys().hasOnly(['device', 'name', 'score', 'at'])
        && request.resource.data.device == resource.data.device
        && validName(request.resource.data.name)
        && request.resource.data.score is int
        && request.resource.data.score >= resource.data.score
        && request.resource.data.score <= 10000000
        && request.resource.data.at is number;
      allow delete: if false;
    }

    match /highscores_defend/{device} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['device', 'name', 'score', 'at'])
        && request.resource.data.device == device
        && validName(request.resource.data.name)
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 10000000
        && request.resource.data.at is number;
      allow update: if request.resource.data.keys().hasOnly(['device', 'name', 'score', 'at'])
        && request.resource.data.device == resource.data.device
        && validName(request.resource.data.name)
        && request.resource.data.score is int
        && request.resource.data.score >= resource.data.score
        && request.resource.data.score <= 10000000
        && request.resource.data.at is number;
      allow delete: if false;
    }

    match /highscores_ice/{device} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['device', 'name', 'score', 'at'])
        && request.resource.data.device == device
        && validName(request.resource.data.name)
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 10000000
        && request.resource.data.at is number;
      allow update: if request.resource.data.keys().hasOnly(['device', 'name', 'score', 'at'])
        && request.resource.data.device == resource.data.device
        && validName(request.resource.data.name)
        && request.resource.data.score is int
        && request.resource.data.score >= resource.data.score
        && request.resource.data.score <= 10000000
        && request.resource.data.at is number;
      allow delete: if false;
    }

    match /highscores_fast/{device} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['device', 'name', 'score', 'at'])
        && request.resource.data.device == device
        && validName(request.resource.data.name)
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 10000000
        && request.resource.data.at is number;
      allow update: if request.resource.data.keys().hasOnly(['device', 'name', 'score', 'at'])
        && request.resource.data.device == resource.data.device
        && validName(request.resource.data.name)
        && request.resource.data.score is int
        && request.resource.data.score >= resource.data.score
        && request.resource.data.score <= 10000000
        && request.resource.data.at is number;
      allow delete: if false;
    }

    match /highscores_find/{device} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['device', 'name', 'score', 'at'])
        && request.resource.data.device == device
        && validName(request.resource.data.name)
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 10000000
        && request.resource.data.at is number;
      allow update: if request.resource.data.keys().hasOnly(['device', 'name', 'score', 'at'])
        && request.resource.data.device == resource.data.device
        && validName(request.resource.data.name)
        && request.resource.data.score is int
        && request.resource.data.score >= resource.data.score
        && request.resource.data.score <= 10000000
        && request.resource.data.at is number;
      allow delete: if false;
    }

    match /highscores_shield/{device} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['device', 'name', 'score', 'at'])
        && request.resource.data.device == device
        && validName(request.resource.data.name)
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 10000000
        && request.resource.data.at is number;
      allow update: if request.resource.data.keys().hasOnly(['device', 'name', 'score', 'at'])
        && request.resource.data.device == resource.data.device
        && validName(request.resource.data.name)
        && request.resource.data.score is int
        && request.resource.data.score >= resource.data.score
        && request.resource.data.score <= 10000000
        && request.resource.data.at is number;
      allow delete: if false;
    }

    match /highscores_jet/{device} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['device', 'name', 'score', 'at'])
        && request.resource.data.device == device
        && validName(request.resource.data.name)
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 10000000
        && request.resource.data.at is number;
      allow update: if request.resource.data.keys().hasOnly(['device', 'name', 'score', 'at'])
        && request.resource.data.device == resource.data.device
        && validName(request.resource.data.name)
        && request.resource.data.score is int
        && request.resource.data.score >= resource.data.score
        && request.resource.data.score <= 10000000
        && request.resource.data.at is number;
      allow delete: if false;
    }

    match /highscores_comet/{device} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['device', 'name', 'score', 'at'])
        && request.resource.data.device == device
        && validName(request.resource.data.name)
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 10000000
        && request.resource.data.at is number;
      allow update: if request.resource.data.keys().hasOnly(['device', 'name', 'score', 'at'])
        && request.resource.data.device == resource.data.device
        && validName(request.resource.data.name)
        && request.resource.data.score is int
        && request.resource.data.score >= resource.data.score
        && request.resource.data.score <= 10000000
        && request.resource.data.at is number;
      allow delete: if false;
    }

    // What players write on the back cover of the book (see src/ui/feedback.ts): a question, an idea or a problem. Anyone can add one (size-bounded);
    // nobody can read, change or delete them from the game: they are read in the console.
    match /feedback/{id} {
      allow read: if false;
      allow create: if request.resource.data.keys().hasOnly(['device', 'name', 'kind', 'text', 'lang', 'at'])
        && request.resource.data.device is string && request.resource.data.device.size() <= 40
        && request.resource.data.name is string && request.resource.data.name.size() <= 16
        && request.resource.data.kind in ['support', 'idea', 'problem']
        && request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 1000
        && request.resource.data.lang is string && request.resource.data.lang.size() <= 5
        && request.resource.data.at is number;
      allow update, delete: if false;
    }
  }
}
